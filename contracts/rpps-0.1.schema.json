{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rpps:schema:manifest:0.1",
  "title": "RPPS 0.1 Draft manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["rpps", "project", "release"],
  "properties": {
    "rpps": { "const": "0.1" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]{2,80}$" },
        "summary": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 40000 }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "authors": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/author" }, "default": [] },
    "licenses": { "$ref": "#/$defs/licenses" },
    "artifacts": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/artifact" }, "default": [] },
    "assemblies": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/assembly" }, "default": [] },
    "components": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/component" }, "default": [] },
    "interfaces": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/interface" }, "default": [] },
    "procedures": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/procedure" }, "default": [] },
    "tests": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/test" }, "default": [] },
    "evidence": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/evidence" }, "default": [] },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "parentRelease": { "$ref": "#/$defs/id" }, "forkedFrom": { "type": "string", "format": "uri", "maxLength": 2048 } }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri", "maxLength": 2048 },
        "instructionsArtifactRef": { "$ref": "#/$defs/id" },
        "acceptsStructuredProposals": { "type": "boolean", "default": false }
      }
    },
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openKnowHow": { "type": "string", "maxLength": 80 },
        "cyclonedx": { "type": "string", "maxLength": 80 },
        "spdx": { "type": "string", "maxLength": 80 },
        "coordinateConvention": { "const": "ROS-REP-103" }
      }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$" },
    "nonEmpty": { "type": "string", "minLength": 1, "maxLength": 500 },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "idArray": { "type": "array", "items": { "$ref": "#/$defs/id" }, "default": [] },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^[a-z0-9]+([.-][a-z0-9-]+)+$" }, "additionalProperties": true },
    "author": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/nonEmpty" }, "role": { "type": "string", "maxLength": 120 }, "url": { "type": "string", "format": "uri", "maxLength": 2048 } }
    },
    "licenses": {
      "type": "object", "additionalProperties": false,
      "properties": { "hardware": { "type": "string", "maxLength": 160 }, "software": { "type": "string", "maxLength": 160 }, "documentation": { "type": "string", "maxLength": 160 }, "media": { "type": "string", "maxLength": 160 } }, "default": {}
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["id", "path", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "kind": { "enum": ["documentation", "cad", "manufacturing", "urdf", "mjcf", "sdf", "firmware", "configuration", "calibration", "test", "bom", "image", "video", "other"] },
        "sha256": { "$ref": "#/$defs/sha256" }, "mediaType": { "type": "string", "maxLength": 200 }, "editable": { "type": "boolean" },
        "source": { "type": "object", "additionalProperties": false, "required": ["url"], "properties": { "url": { "type": "string", "format": "uri", "maxLength": 2048 }, "revision": { "type": "string", "maxLength": 200 }, "retrievedAt": { "type": "string", "format": "date-time" } } }
      }
    },
    "component": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "quantity"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/nonEmpty" }, "quantity": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 }, "unit": { "type": "string", "minLength": 1, "maxLength": 40, "default": "each" }, "manufacturer": { "type": "string", "maxLength": 160 }, "mpn": { "type": "string", "maxLength": 160 }, "revision": { "type": "string", "maxLength": 160 }, "fabricated": { "type": "boolean", "default": false }, "optional": { "type": "boolean", "default": false }, "artifactRefs": { "$ref": "#/$defs/idArray" } }
    },
    "assembly": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/nonEmpty" }, "description": { "type": "string", "maxLength": 4000 }, "componentRefs": { "$ref": "#/$defs/idArray" }, "artifactRefs": { "$ref": "#/$defs/idArray" }, "interfaceRefs": { "$ref": "#/$defs/idArray" } }
    },
    "interface": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "kind"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/nonEmpty" }, "kind": { "enum": ["mechanical", "electrical", "communication", "software", "coordinate-frame", "capability", "environmental", "other"] }, "description": { "type": "string", "maxLength": 4000 }, "specifications": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] }, "default": {} }, "evidenceRefs": { "$ref": "#/$defs/idArray" } }
    },
    "procedure": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "title"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["assembly", "configuration", "calibration", "test", "operation", "maintenance"] }, "title": { "$ref": "#/$defs/nonEmpty" }, "artifactRefs": { "$ref": "#/$defs/idArray" }, "steps": { "type": "array", "maxItems": 1000, "default": [], "items": { "type": "object", "additionalProperties": false, "required": ["id", "instruction"], "properties": { "id": { "$ref": "#/$defs/id" }, "instruction": { "type": "string", "minLength": 1, "maxLength": 20000 } } } }, "expectedResult": { "type": "string", "maxLength": 4000 } }
    },
    "test": {
      "type": "object", "additionalProperties": false, "required": ["id", "title"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/nonEmpty" }, "procedureRef": { "$ref": "#/$defs/id" }, "expectedResult": { "type": "string", "maxLength": 4000 } }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["id", "claim", "level"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "claim": { "$ref": "#/$defs/nonEmpty" }, "level": { "enum": ["structured", "tested", "reproduced", "repeated"] }, "compatibilitySource": { "enum": ["manufacturer-declared", "maintainer-declared", "community-observed", "independently-reproduced", "disputed", "outdated"] }, "artifactRefs": { "$ref": "#/$defs/idArray" }, "observedAt": { "type": "string", "format": "date-time" }, "currentAt": { "type": "string", "format": "date-time" } }
    }
  }
}
