{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robopartpicker.com/contracts/import-batch.v1.schema.json",
  "title": "RoboPartPicker external ingestion batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchId", "idempotencyKey", "retrievalTimestamp", "source", "records"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "batchId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 200 },
    "retrievalTimestamp": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/source" },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "httpUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https?://"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 300 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 200 },
        "type": { "type": "string", "minLength": 2, "maxLength": 100 },
        "baseUrl": { "oneOf": [{ "$ref": "#/$defs/httpUrl" }, { "type": "null" }] },
        "priority": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 },
        "trustWeight": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalRecordId", "recordType", "rawPayload", "parsedData", "confidence"],
      "properties": {
        "externalRecordId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "recordType": {
          "enum": ["manufacturer", "supplier", "component", "offer", "project", "bom", "integration", "evidence", "teardown", "commercial_robot", "marketplace_reference"]
        },
        "sourceUrl": { "oneOf": [{ "$ref": "#/$defs/httpUrl" }, { "type": "null" }] },
        "rawPayload": {},
        "parsedData": { "type": "object" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "action": { "enum": ["upsert", "withdraw"], "default": "upsert" },
        "withdrawalOfExternalRecordId": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 500 }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "withdraw" } }, "required": ["action"] },
          "then": { "required": ["withdrawalOfExternalRecordId"] }
        },
        {
          "if": { "properties": { "recordType": { "const": "manufacturer" } } },
          "then": { "properties": { "parsedData": { "$ref": "#/$defs/manufacturer" } } }
        },
        {
          "if": { "properties": { "recordType": { "const": "supplier" } } },
          "then": { "properties": { "parsedData": { "$ref": "#/$defs/supplier" } } }
        },
        {
          "if": { "properties": { "recordType": { "const": "component" } } },
          "then": { "properties": { "parsedData": { "$ref": "#/$defs/component" } } }
        },
        {
          "if": { "properties": { "recordType": { "const": "offer" } } },
          "then": { "properties": { "parsedData": { "$ref": "#/$defs/offer" } } }
        },
        {
          "if": { "properties": { "recordType": { "const": "project" } } },
          "then": { "properties": { "parsedData": { "$ref": "#/$defs/project" } } }
        },
        {
          "if": { "properties": { "recordType": { "const": "bom" } } },
          "then": { "properties": { "parsedData": { "$ref": "#/$defs/bom" } } }
        },
        {
          "if": { "properties": { "recordType": { "const": "integration" } } },
          "then": { "properties": { "parsedData": { "$ref": "#/$defs/integration" } } }
        },
        {
          "if": { "properties": { "recordType": { "const": "evidence" } } },
          "then": { "properties": { "parsedData": { "$ref": "#/$defs/evidence" } } }
        },
        {
          "if": { "properties": { "recordType": { "const": "teardown" } } },
          "then": { "properties": { "parsedData": { "$ref": "#/$defs/titled" } } }
        },
        {
          "if": { "properties": { "recordType": { "const": "commercial_robot" } } },
          "then": { "properties": { "parsedData": { "$ref": "#/$defs/named" } } }
        },
        {
          "if": { "properties": { "recordType": { "const": "marketplace_reference" } } },
          "then": { "properties": { "parsedData": { "$ref": "#/$defs/marketplaceReference" } } }
        }
      ]
    },
    "manufacturer": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "websiteUrl": { "oneOf": [{ "$ref": "#/$defs/httpUrl" }, { "type": "null" }] },
        "headquartersRegion": { "oneOf": [{ "type": "string", "maxLength": 50 }, { "type": "null" }] }
      }
    },
    "supplier": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "websiteUrl": { "oneOf": [{ "$ref": "#/$defs/httpUrl" }, { "type": "null" }] },
        "regions": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 30 }, "default": [] }
      }
    },
    "component": {
      "type": "object",
      "required": ["name", "category"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "manufacturerName": { "oneOf": [{ "type": "string", "maxLength": 300 }, { "type": "null" }] },
        "manufacturerPartNumber": { "oneOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }] },
        "specs": { "type": "object", "default": {} }
      }
    },
    "offer": {
      "type": "object",
      "required": ["supplierExternalId", "componentExternalId", "currency", "unitPriceMinor", "observedAt"],
      "properties": {
        "supplierExternalId": { "type": "string", "minLength": 1, "maxLength": 300 },
        "componentExternalId": { "type": "string", "minLength": 1, "maxLength": 300 },
        "supplierSku": { "oneOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }] },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "unitPriceMinor": { "type": "integer", "minimum": 0 },
        "regionCode": { "oneOf": [{ "type": "string", "maxLength": 30 }, { "type": "null" }] },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "repositoryUrl": { "oneOf": [{ "$ref": "#/$defs/httpUrl" }, { "type": "null" }] },
        "licenseSpdx": { "oneOf": [{ "type": "string", "maxLength": 100 }, { "type": "null" }] },
        "extracted": { "type": "object", "default": {} }
      }
    },
    "bom": {
      "type": "object",
      "required": ["name", "items"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "items": { "type": "array", "maxItems": 2000, "items": { "type": "object" } }
      }
    },
    "integration": {
      "type": "object",
      "required": ["name", "integrationType"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "integrationType": { "type": "string", "minLength": 1, "maxLength": 100 },
        "entities": { "type": "array", "maxItems": 1000, "items": { "type": "object" }, "default": [] }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["title", "sourceType"],
      "properties": {
        "title": { "$ref": "#/$defs/name" },
        "sourceType": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sourceUrl": { "oneOf": [{ "$ref": "#/$defs/httpUrl" }, { "type": "null" }] }
      }
    },
    "titled": {
      "type": "object",
      "required": ["title"],
      "properties": { "title": { "$ref": "#/$defs/name" } }
    },
    "named": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "$ref": "#/$defs/name" } }
    },
    "marketplaceReference": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/name" },
        "sourceUrl": { "oneOf": [{ "$ref": "#/$defs/httpUrl" }, { "type": "null" }] }
      }
    }
  }
}
