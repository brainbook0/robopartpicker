{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robopartpicker.com/contracts/rpps-1.0.0.schema.json",
  "title": "RoboPartPicker Project Standard 1.0.0",
  "description": "RoboPartPicker's open project interchange format; it is not an established industry standard.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rpps_version", "name", "slug", "version", "bom"],
  "properties": {
    "rpps_version": { "const": "1.0.0" },
    "name": { "$ref": "#/$defs/nonEmpty" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]{2,80}$" },
    "version": { "type": "string", "maxLength": 40 },
    "summary": { "type": "string", "maxLength": 280 },
    "description": { "type": "string", "maxLength": 20000 },
    "license": { "type": "string", "maxLength": 80 },
    "authors": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/author" } },
    "repo_url": { "$ref": "#/$defs/url" },
    "docs_url": { "$ref": "#/$defs/url" },
    "cover_image_url": { "$ref": "#/$defs/url" },
    "tags": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 40 } },
    "hardware": { "$ref": "#/$defs/hardware" },
    "software": { "$ref": "#/$defs/software" },
    "build": { "$ref": "#/$defs/build" },
    "bom": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/bomItem" }, "default": [] },
    "assembly": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/assemblyStep" } },
    "files": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/file" } },
    "integrations": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/integration" } },
    "known_issues": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/knownIssue" } },
    "evidence": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/evidence" } }
  },
  "$defs": {
    "url": { "type": "string", "format": "uri", "maxLength": 2048 },
    "nonEmpty": { "type": "string", "minLength": 1, "maxLength": 500 },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "role": { "type": "string", "maxLength": 80 },
        "url": { "$ref": "#/$defs/url" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "kind": { "enum": ["readme", "cad", "urdf", "mjcf", "firmware", "config", "image", "video", "doc", "other"] },
        "url": { "$ref": "#/$defs/url" },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "bomItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "qty"],
      "properties": {
        "ref": { "type": "string", "maxLength": 64 },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "manufacturer": { "type": "string", "maxLength": 120 },
        "mpn": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "maxLength": 60 },
        "qty": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "unit_cost_usd": { "type": "number", "minimum": 0 },
        "supplier_url": { "$ref": "#/$defs/url" },
        "fabricated": { "type": "boolean" },
        "optional": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 1000 }
      }
    },
    "assemblyStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "maxLength": 40 },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "body": { "type": "string", "maxLength": 8000 },
        "depends_on": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 40 } },
        "tools": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 80 } },
        "duration_min": { "type": "integer", "minimum": 0 }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b", "status"],
      "properties": {
        "a": { "$ref": "#/$defs/nonEmpty" },
        "b": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["verified", "documented", "compatible", "adaptation-required", "unverified", "incompatible"] },
        "notes": { "type": "string", "maxLength": 2000 },
        "evidence_url": { "$ref": "#/$defs/url" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "source_type"],
      "properties": {
        "claim": { "$ref": "#/$defs/nonEmpty" },
        "source_type": { "enum": ["datasheet", "repo", "docs", "paper", "user-build", "test", "teardown", "supplier", "listing", "inference"] },
        "source_url": { "$ref": "#/$defs/url" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dof": { "type": "integer", "minimum": 0 },
        "payload_kg": { "type": "number", "minimum": 0 },
        "weight_kg": { "type": "number", "minimum": 0 },
        "height_cm": { "type": "number", "minimum": 0 },
        "compute": { "type": "string", "maxLength": 120 }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string", "maxLength": 80 },
        "middleware": { "type": "string", "maxLength": 80 },
        "languages": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 40 } },
        "ros_support": { "enum": ["native", "community", "none"] },
        "simulators": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 60 } }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "difficulty": { "enum": ["beginner", "intermediate", "advanced", "expert"] },
        "estimated_time_hours": { "type": "number", "minimum": 0 },
        "estimated_cost_usd": { "type": "number", "minimum": 0 },
        "required_tools": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 80 } },
        "required_skills": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 80 } },
        "fabrication": { "type": "array", "maxItems": 10, "items": { "enum": ["3d-print", "cnc", "laser", "waterjet", "manual", "pcb"] } }
      }
    },
    "knownIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/nonEmpty" },
        "body": { "type": "string", "maxLength": 4000 }
      }
    }
  }
}
