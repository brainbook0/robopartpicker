{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "robopartpicker",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "robopartpicker",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "robopartpicker-files"
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "APP_NAME": "RoboPartPicker",
    "AI_PROVIDER_URL": "https://openrouter.ai/api/v1",
    "AI_MODEL": "deepseek/deepseek-v4-pro",
    "AI_DAILY_TOKEN_LIMIT": "150000",
    "AI_MAX_OUTPUT_TOKENS": "2048"
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "INGESTION_SECRET"]
  },
  "env": {
    "preview": {
      "name": "robopartpicker-preview",
      "workers_dev": true,
      "preview_urls": true,
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "robopartpicker-preview",
          "database_id": "af9e3aaa-4e74-4083-8317-a642bf0e07a6",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "robopartpicker-preview-files"
        }
      ],
      "vars": {
        "APP_ENV": "preview",
        "APP_NAME": "RoboPartPicker",
        "AI_PROVIDER_URL": "https://openrouter.ai/api/v1",
        "AI_MODEL": "deepseek/deepseek-v4-pro",
        "AI_DAILY_TOKEN_LIMIT": "150000",
        "AI_MAX_OUTPUT_TOKENS": "2048"
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "INGESTION_SECRET"]
      }
    },
    "production": {
      "routes": [
        { "pattern": "robopartpicker.com", "custom_domain": true },
        { "pattern": "www.robopartpicker.com", "custom_domain": true }
      ],
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "robopartpicker-production",
          "database_id": "10c57e79-e34f-4643-8c4e-4f0c7968a74d",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "robopartpicker-files"
        }
      ],
      "vars": {
        "APP_ENV": "production",
        "APP_NAME": "RoboPartPicker",
        "PUBLIC_BASE_URL": "https://robopartpicker.com",
        "AI_PROVIDER_URL": "https://openrouter.ai/api/v1",
        "AI_MODEL": "deepseek/deepseek-v4-pro",
        "AI_DAILY_TOKEN_LIMIT": "150000",
        "AI_MAX_OUTPUT_TOKENS": "2048"
      },
      "secrets": {
        // Optional Google auth uses GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET.
        // The provider stays disabled unless both Cloudflare secrets exist.
        "required": ["BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "INGESTION_SECRET"]
      }
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "upload_source_maps": true
}
