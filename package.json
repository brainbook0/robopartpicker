{
  "name": "robopartpicker",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/sync-public-seo.ts && vite dev",
    "build": "cross-env CLOUDFLARE_ENV=production sh -c 'tsx scripts/sync-public-seo.ts && vite build'",
    "build:preview": "cross-env CLOUDFLARE_ENV=preview sh -c 'tsx scripts/sync-public-seo.ts && vite build'",
    "build:dev": "tsx scripts/sync-public-seo.ts && vite build --mode development",
    "cf:types": "wrangler types",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "preview": "npm run build && vite preview",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run contracts:validate && npm run test && npm run build",
    "contracts:validate": "tsx scripts/validate-contracts.ts",
    "rpps:init": "tsx scripts/rpps-cli.ts init rpps.yaml",
    "rpps:validate": "tsx scripts/rpps-cli.ts validate",
    "rpps:buildability": "tsx scripts/rpps-cli.ts buildability",
    "rpps:migrate": "tsx scripts/rpps-cli.ts migrate",
    "db:migration:create": "wrangler d1 migrations create robopartpicker",
    "db:migrations:list": "wrangler d1 migrations list robopartpicker --local",
    "db:migrations:list:remote": "wrangler d1 migrations list robopartpicker --env production --remote",
    "db:migrations:list:preview": "wrangler d1 migrations list DB --env preview --remote",
    "db:migrate:local": "wrangler d1 migrations apply robopartpicker --local",
    "db:migrate:remote": "tsx scripts/apply-remote-migration-compat.ts --env production && wrangler d1 migrations apply DB --env production --remote",
    "db:migrate:preview": "tsx scripts/apply-remote-migration-compat.ts --env preview && wrangler d1 migrations apply DB --env preview --remote",
    "db:init": "npm run db:migrate:local && npm run db:validate",
    "db:reset": "tsx scripts/reset-local-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:preview": "tsx scripts/seed.ts --remote --env preview",
    "db:inspect": "wrangler d1 execute robopartpicker --local --command=\"SELECT name, type FROM sqlite_schema WHERE type IN ('table','index') ORDER BY type, name\"",
    "db:export": "tsx scripts/export-local-db.ts",
    "db:validate": "tsx scripts/validate-schema.ts",
    "db:validate:preview": "tsx scripts/validate-schema.ts --remote --env preview",
    "deploy": "npm run build && wrangler deploy --env production",
    "deploy:preview": "npm run build:preview && wrangler deploy --env preview",
    "deploy:dry-run": "npm run build && wrangler deploy --env production --dry-run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "1.0.46",
    "@ai-sdk/react": "^2",
    "@better-auth/oauth-provider": "1.6.23",
    "@hookform/resolvers": "^3.10.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.83.0",
    "@types/three": "^0.160.0",
    "ai": "^5",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "fflate": "0.8.3",
    "hono": "^4.12.31",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.462.0",
    "motion": "^12.42.2",
    "nanoid": "^6.0.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.160.0",
    "urdf-loader": "^0.12.6",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^0.9.9",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.1",
    "@cloudflare/vitest-pool-workers": "0.18.6",
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "4.3.1",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "4.20.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  }
}
