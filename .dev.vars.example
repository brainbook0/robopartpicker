# Generate a unique local value with: npx auth@1.6.23 secret
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:8080

# Dedicated credential for POST /api/v1/imports/batches.
INGESTION_SECRET=replace-with-a-separate-random-service-secret

# Optional integration boundaries. Leave blank to report the capability as unavailable.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=
EMAIL_FROM=RoboPartPicker <no-reply@example.invalid>
GITHUB_TOKEN=
# Optional Google sign-in. Configure both or leave both blank.
# Local callback: http://127.0.0.1:8080/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AI_PROVIDER_URL=https://openrouter.ai/api/v1
AI_PROVIDER_KEY=
AI_MODEL=deepseek/deepseek-v4-pro
AI_DAILY_TOKEN_LIMIT=150000
AI_MAX_OUTPUT_TOKENS=2048
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
